model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["FactAutoAttendantDaily","FactCallQueueDaily","DimAutoAttendant","DimCallQueue"]

ref table FactAutoAttendantDaily
ref table FactCallQueueDaily
ref table DimAutoAttendant
ref table DimCallQueue
ref table DimDate

ref cultureInfo en-US

