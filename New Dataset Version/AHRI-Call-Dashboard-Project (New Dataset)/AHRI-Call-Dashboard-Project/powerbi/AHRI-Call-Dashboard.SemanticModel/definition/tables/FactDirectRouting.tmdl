	column 'Outcome Category' =
			
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "transfer completed")
			        || CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "Call Transferred"), "Transfer completed",
			
			    CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "Normal call clearing")
			        || CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "NORMAL_CLEARING")
			        || FactDirectRouting[FinalSIPPhrase] = "BYE"
			        || FactDirectRouting[FinalSIPPhrase] = "Call is ended."
			        || CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "modality controller")
			        || CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "one participant was remaining")
			        || FactDirectRouting[FinalSIPPhrase] = "Call ended by media agent."
			        || CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "recording_accepted")
			        || CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "recording_too_long"), "Normal hangup",
			
			    FactDirectRouting[FinalSIPPhrase] = "LocalUserInitiated"
			        || FactDirectRouting[FinalSIPPhrase] = "ORIGINATOR_CANCEL"
			        || FactDirectRouting[FinalSIPPhrase] = "Canceled"
			        || FactDirectRouting[FinalSIPPhrase] = "Call cancelled on timeout."
			        || CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "silence_timeout"), "Caller-initiated disconnect",
			
			    "System/infrastructure issue"
			)
		lineageTag: e89926ac-a3a3-40d4-8900-db6cbc15cce4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Failure Detail' =
			
			IF(
			    FactDirectRouting[Outcome Category] = "System/infrastructure issue",
			    IF(
			        CONTAINSSTRING(FactDirectRouting[FinalSIPPhrase], "User data not found"),
			        "Destination/routing issue",
			        "Platform/technical issue"
			    ),
			    BLANK()
			)
		lineageTag: 603745f1-56eb-4000-b570-2e499f5ebab6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Queue Service Clean' = IF(ISBLANK(FactDirectRouting[QueueService]), "No queue reached", FactDirectRouting[QueueService])
		lineageTag: f10e1dc4-e28c-4227-bdb1-a67e33b58f94
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Call Stage' = SWITCH( TRUE(), FactDirectRouting[DisplayName] = "", "Unknown", CONTAINSSTRING(FactDirectRouting[DisplayName], "Main IVR"), "IVR", CONTAINSSTRING(FactDirectRouting[DisplayName], "Queue"), "Queue", "Agent" )
		lineageTag: 00baf45b-05c6-4ab0-bb56-538061fc5ba7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Outcome Group' = IF( FactDirectRouting[Outcome Category] IN {"Normal hangup", "Transfer completed"}, "Normal hangup / transfer", "Disconnect / issue" )
		lineageTag: d7611898-375b-4008-b473-ebe8c650fd59
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Final Leg' = VAR MaxInvite = CALCULATE( MAX(FactDirectRouting[InviteTimeUTC]), ALLEXCEPT(FactDirectRouting, FactDirectRouting[SharedCorrelationId]) ) RETURN IF(FactDirectRouting[InviteTimeUTC] = MaxInvite, "Final leg", "Earlier leg")
		lineageTag: 934549e6-585f-42bc-a5e5-bd98f020a623
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Duration Bucket' = SWITCH( TRUE(), FactDirectRouting[DurationSeconds] = 0, "0s (no connection)", FactDirectRouting[DurationSeconds] <= 30, "Under 30s", FactDirectRouting[DurationSeconds] <= 120, "30s-2min", FactDirectRouting[DurationSeconds] <= 300, "2-5min", "5min+" )
		lineageTag: aa2ef3fd-d195-4fff-8e4c-59b876e4f495
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition FactDirectRouting = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ProjectRoot & "\data\source\DirectRouting_Ehsan_2026-09-01.xlsx"), null, true),
				    Sheet = Source{[Item="Sheet1", Kind="Sheet"]}[Data],
				    Headers = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers, {"CorrelationId", "AAD ObjectId", "UPN", "Display Name", "User country", "External Country", "Invite time", "Start time", "Failure time", "End time", "Duration (seconds)", "Success", "Caller Number", "Callee Number", "Call type", "Call Direction", "Azure region for Media", "Azure region for Signaling", "Final SIP code", "Final Microsoft subcode", "Final SIP Phrase", "SBC FQDN", "Media bypass", "Shared correlation ID", "Transfer or Correlation ID"}),
				    Renamed = Table.RenameColumns(Selected, {{"AAD ObjectId", "AADObjectId"}, {"UPN", "ResourceAccount"}, {"Display Name", "DisplayName"}, {"User country", "UserCountry"}, {"External Country", "ExternalCountry"}, {"Invite time", "InviteTimeUTC"}, {"Start time", "StartTimeUTC"}, {"Failure time", "FailureTimeUTC"}, {"End time", "EndTimeUTC"}, {"Duration (seconds)", "DurationSeconds"}, {"Caller Number", "CallerNumber"}, {"Callee Number", "CalleeNumber"}, {"Call type", "CallType"}, {"Call Direction", "CallDirection"}, {"Azure region for Media", "MediaRegion"}, {"Azure region for Signaling", "SignalingRegion"}, {"Final SIP code", "FinalSIPCode"}, {"Final Microsoft subcode", "FinalMicrosoftSubcode"}, {"Final SIP Phrase", "FinalSIPPhrase"}, {"SBC FQDN", "SBCFQDN"}, {"Media bypass", "MediaBypass"}, {"Shared correlation ID", "SharedCorrelationId"}, {"Transfer or Correlation ID", "TransferCorrelationId"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"CorrelationId", type text}, {"AADObjectId", type text}, {"ResourceAccount", type text}, {"DisplayName", type text}, {"UserCountry", type text}, {"ExternalCountry", type text}, {"Success", type text}, {"CallerNumber", type text}, {"CalleeNumber", type text}, {"CallType", type text}, {"CallDirection", type text}, {"MediaRegion", type text}, {"SignalingRegion", type text}, {"FinalSIPPhrase", type text}, {"SBCFQDN", type text}, {"MediaBypass", type text}, {"SharedCorrelationId", type text}, {"TransferCorrelationId", type text}, {"DurationSeconds", Int64.Type}, {"FinalSIPCode", Int64.Type}, {"FinalMicrosoftSubcode", Int64.Type}}, "en-AU"),
				    Accounts = Table.TransformColumns(Typed, {{"ResourceAccount", each if _ = null then null else Text.Lower(Text.Trim(Text.Clean(_))), type nullable text}}),
				    ParseUTC = (value as nullable text) as nullable datetime =>
				        if value = null then null
				        else if Text.Trim(value) = "" then null
				        else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(value), 0)),
				    Times = Table.TransformColumns(Accounts, {{"InviteTimeUTC", ParseUTC, type nullable datetime}, {"StartTimeUTC", ParseUTC, type nullable datetime}, {"FailureTimeUTC", ParseUTC, type nullable datetime}, {"EndTimeUTC", ParseUTC, type nullable datetime}}),
				    // Melbourne DST rules since 2008: first Sunday April (03:00 daylight time)
				    // and first Sunday October (02:00 standard time). Compare UTC instants.
				    Melbourne = (utc as datetime) as datetime =>
				        let
				            y = Date.Year(Date.From(utc)),
				            FirstSunday = (month as number) as date =>
				                let first = #date(y, month, 1)
				                in Date.AddDays(first, Number.Mod(7 - Date.DayOfWeek(first, Day.Sunday), 7)),
				            DstEndUTC = DateTime.From(FirstSunday(4)) + #duration(0, 3, 0, 0) - #duration(0, 11, 0, 0),
				            DstStartUTC = DateTime.From(FirstSunday(10)) + #duration(0, 2, 0, 0) - #duration(0, 10, 0, 0),
				            Offset = if y < 2008 then error "Melbourne dates before 2008 require historical timezone rules."
				                     else if utc < DstEndUTC or utc >= DstStartUTC then 11 else 10
				        in utc + #duration(0, Offset, 0, 0),
				    LocalTime = Table.AddColumn(Times, "InviteTimeMelbourne", each Melbourne([InviteTimeUTC]), type datetime),
				    LocalDate = Table.AddColumn(LocalTime, "InviteDateMelbourne", each Date.From([InviteTimeMelbourne]), type date),
				    UTCDate = Table.AddColumn(LocalDate, "InviteDateUTC", each Date.From([InviteTimeUTC]), type date),
				    LocalHour = Table.AddColumn(UTCDate, "InviteHourMelbourne", each Time.Hour(Time.From([InviteTimeMelbourne])), Int64.Type),
				    Entry = Table.AddColumn(LocalHour, "IsEntryRecord", each [CorrelationId] = [SharedCorrelationId], type logical),
				    // Source row is a within-file key, not a durable cross-export call identifier.
				    RowKey = Table.AddIndexColumn(Entry, "SourceRow", 2, 1, Int64.Type),
				    MainEntry = Table.AddColumn(RowKey, "IsMainEntry", each [ResourceAccount] = "aa-mainivr-v2@ahri.com.au" and [IsEntryRecord], type logical),
				    IsQueue = Table.AddColumn(MainEntry, "IsQueue", each if [DisplayName] = null then false else Text.Contains([DisplayName], "Queue", Comparer.OrdinalIgnoreCase), type logical),
				    IsOverflow = Table.AddColumn(IsQueue, "IsOverflow", each if [DisplayName] = null then false else [IsQueue] and Text.Contains([DisplayName], "Overflow", Comparer.OrdinalIgnoreCase), type logical),
				    Destination = Table.AddColumn(IsOverflow, "DestinationClass", each
				        if [ResourceAccount] = "aa-mainivr-v2@ahri.com.au" then "Main IVR"
				        else if [IsQueue] then "Queue"
				        else if [ResourceAccount] = null then "Unmapped resource"
				        else if [CallType] = "ByotIn" then "User-associated"
				        else "Other application", type text),
				    Service = Table.AddColumn(Destination, "QueueService", each if not [IsQueue] then null else
				        let n = Text.Replace(Text.Replace([DisplayName], " Overflow", ""), " overflow", "")
				        in Text.Trim(Text.BeforeDelimiter(n, " Queue")), type nullable text),
				    QueueType = Table.AddColumn(Service, "QueueDestination", each if not [IsQueue] then "Not a queue" else if [IsOverflow] then "Overflow" else "Primary", type text),
				    Failure = Table.AddColumn(QueueType, "FailureCategory", each
				        if [Success] <> "No" then null
				        else if [FinalSIPPhrase] = "User data not found." then "User lookup failure"
				        else if [FinalSIPPhrase] = "ORIGINATOR_CANCEL" then "Originator cancellation"
				        else if Text.Contains([FinalSIPPhrase], "Trouter", Comparer.OrdinalIgnoreCase) then "Endpoint delivery error"
				        else if [FinalSIPPhrase] = "Server Internal Error" then "Internal server error"
				        else if [FinalSIPPhrase] = "Canceled" then "Other cancellation"
				        else "Other unsuccessful outcome", type nullable text),
				    Band = Table.AddColumn(Failure, "DurationBand", each if [DurationSeconds] = 0 then "0 seconds" else if [DurationSeconds] <= 30 then "1 to 30 seconds" else if [DurationSeconds] <= 60 then "31 to 60 seconds" else if [DurationSeconds] <= 90 then "61 to 90 seconds" else "Over 90 seconds", type text),
				    BandOrder = Table.AddColumn(Band, "DurationBandOrder", each if [DurationSeconds] = 0 then 0 else if [DurationSeconds] <= 30 then 1 else if [DurationSeconds] <= 60 then 2 else if [DurationSeconds] <= 90 then 3 else 4, Int64.Type)
				in
				    BandOrder

	annotation PBI_ResultType = Table

