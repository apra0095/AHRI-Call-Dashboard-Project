table FactDirectRouting
	lineageTag: d8249466-366d-5b9b-97a6-8e71d1cb829b

	measure 'Total Inbound Records' =
			
			CALCULATE(
			    COUNTROWS(FactDirectRouting),
			    FactDirectRouting[CallDirection] = "Inbound")
		formatString: 0
		lineageTag: 00c4546c-8185-4de7-9528-94ff05e56051

	measure 'Success Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FactDirectRouting),
			        FactDirectRouting[Success] = "Yes"
			    ),
			    COUNTROWS(FactDirectRouting)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 924948aa-aefe-4bfd-8366-29892ee148ba

	measure 'Zero-Duration Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FactDirectRouting),
			        FactDirectRouting[DurationSeconds] = 0
			    ),
			    COUNTROWS(FactDirectRouting)
			)
		lineageTag: 15466c99-0164-41a9-9966-803823983a81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mean Duration' = AVERAGE(FactDirectRouting[DurationSeconds])
		formatString: 0
		lineageTag: a68953ed-d310-449a-beca-ead3f32f0c6e

	measure 'Longest Typical Call' =
			
			CALCULATE(
			    AVERAGE(FactDirectRouting[DurationSeconds]),
			    FactDirectRouting[Outcome Category] = "Caller-initiated disconnect"
			)
		lineageTag: 7d64e0f5-2cc9-429d-b61b-cb32b7d06c05

		annotation PBI_FormatHint = {"isGeneralNumber":true}

