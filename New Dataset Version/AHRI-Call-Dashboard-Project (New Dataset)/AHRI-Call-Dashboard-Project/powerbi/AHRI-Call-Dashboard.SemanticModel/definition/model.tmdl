model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["ProjectRoot","FactDirectRouting","FactRoutingGroup","DimQualityCheck","_RoutingMeasures"]

ref table FactDirectRouting
ref table FactRoutingGroup
ref table DimRoutingDate
ref table DimQualityCheck
ref table _RoutingMeasures

